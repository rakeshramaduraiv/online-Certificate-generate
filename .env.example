# =============================================
# ROOT .env.example — Copy to .env and fill in
# =============================================
# This file is for Docker Compose deployments.
# For Render.com / Railway / individual service deploys,
# set these as environment variables in the dashboard.

# ------ DATABASE (PostgreSQL) ------
DB_USERNAME=certuser
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# PostgreSQL root/superuser password (used by Docker Compose only)
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_ROOT_PASSWORD

# Connection URL used by the Spring Boot app (auto-set in docker-compose)
# For external PostgreSQL (Railway etc.): jdbc:postgresql://<host>:<port>/<dbname>
DB_URL=jdbc:postgresql://postgres:5432/certificate_db

# ------ JWT ------
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_MIN_256_BITS
JWT_EXPIRATION=86400000

# ------ CORS ------
# The URL(s) of your deployed frontend (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ------ FRONTEND ------
# The URL of your deployed backend API
REACT_APP_API_URL=http://localhost:8080
